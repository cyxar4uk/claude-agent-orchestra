# Copy to .env and fill in. Never commit .env.

# --- Authentication (required for the default "claude" backend) ---
ANTHROPIC_API_KEY=

# --- Backend ---
# "claude" = real Claude Agent SDK calls, "mock" = offline deterministic backend (no API key, no cost)
ORCHESTRA_BACKEND=claude

# --- Models (any valid Claude model ID) ---
ORCHESTRA_WORKER_MODEL=claude-sonnet-5-5
# Optional: a stronger model for planner agents. Empty = use the worker model.
# ORCHESTRA_PLANNER_MODEL=claude-opus-5-5

# --- Paths ---
# Directory agents work in (read/edit files there). Defaults to the current directory.
# In Docker this is /workspace (mounted from ORCHESTRA_WORKSPACE_HOST in docker-compose.yml).
ORCHESTRA_WORKSPACE=.
# SQLite database + run artifacts live here.
ORCHESTRA_DATA_DIR=data
# Optional: path to your orchestra.yaml (agents / workflows / knowledge). Empty = built-in defaults.
# ORCHESTRA_CONFIG=examples/quickstart/orchestra.yaml

# --- Safety / limits ---
# default | acceptEdits | plan | bypassPermissions | dontAsk | auto  (see Claude Agent SDK docs)
ORCHESTRA_PERMISSION_MODE=acceptEdits
ORCHESTRA_MAX_TURNS=30
# Optional hard budget per step in USD
# ORCHESTRA_MAX_BUDGET_USD=2.0
ORCHESTRA_MAX_CONCURRENT_RUNS=2

# --- REST API ---
ORCHESTRA_HOST=127.0.0.1
ORCHESTRA_PORT=8000
# If set, every endpoint except /health requires "Authorization: Bearer <token>"
# ORCHESTRA_API_TOKEN=change-me
ORCHESTRA_LOG_LEVEL=INFO
